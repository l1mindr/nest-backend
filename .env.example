# Database
DATA_SOURCE_USERNAME=postgres
DATA_SOURCE_PASSWORD=changeme
DATA_SOURCE_HOST=localhost
DATA_SOURCE_PORT=5432
DATA_SOURCE_DATABASE=mintegs_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Sessions
MAX_ACTIVE_SESSIONS=10

# Secrets (generate strong values for production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme
CSRF_TOKEN_SECRET=changeme

# Environment
NODE_ENV=development

# Logging (true|false - disables HTTP request/response logs when false)
ENABLE_HTTP_LOGS=true
