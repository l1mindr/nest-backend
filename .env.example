# Database
DATA_SOURCE_USERNAME=postgres
DATA_SOURCE_PASSWORD=changeme
DATA_SOURCE_HOST=localhost
DATA_SOURCE_PORT=5432
DATA_SOURCE_DATABASE=mintegs_db
# DATA_SOURCE_POOL_SIZE=10
# DATA_SOURCE_CONNECT_TIMEOUT_MS=10000
# DATA_SOURCE_IDLE_TIMEOUT_MS=30000

# MongoDB (for logging persistence)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nest_logs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Sessions
MAX_ACTIVE_SESSIONS=10

# Email (Gmail SMTP)
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM="You <you@gmail.com>"
# APP_NAME=NestJS Backend
#
# For local development, point these at Mailpit instead and read every email at
# http://localhost:8025 rather than sending to a real address. The provider is
# these six variables and nothing else — there is one SMTP implementation and it
# does not know which server answered.
#
#   docker compose -f ../docker/compose.yml up -d mailpit
#
#   EMAIL_HOST=localhost
#   EMAIL_PORT=1025
#   EMAIL_SECURE=false        # Mailpit runs without TLS
#   EMAIL_USER=dev@mailpit.test
#   EMAIL_APP_PASSWORD=mailpit-accepts-any-password
#   EMAIL_FROM="Local Dev <no-reply@mailpit.test>"
#
# Credentials are still required — the schema demands them and the production
# provider needs them — and Mailpit takes whatever arrives. `.env.test` is
# already configured this way; see docs/testing.md.

# Email queue (BullMQ, on the Redis instance above)
# Email delivery is asynchronous and at-least-once; see docs/email.md.
# QUEUE_PREFIX=bull                      # namespace, if several deployments share one Redis
# EMAIL_QUEUE_ATTEMPTS=5                 # total tries per email, first included (1-20)
# EMAIL_QUEUE_BACKOFF_MS=5000            # exponential base delay between tries
# EMAIL_QUEUE_KEEP_COMPLETED=100         # completed jobs retained
# EMAIL_QUEUE_KEEP_FAILED=1000           # failed jobs retained for inspection
# EMAIL_QUEUE_PUBLISH_TIMEOUT_MS=2000    # cap on publishing blocking a request

# Asset catalogue sync (BullMQ, on the Redis instance above)
# Assets are synchronised from CoinGecko on a schedule; a failed run is retried
# with exponential backoff. See docs/market-data.md and the market-data report.
# ASSET_SYNC_INTERVAL=3600               # repeat interval in seconds (300-604800)
# ASSET_SYNC_QUEUE_ATTEMPTS=4            # retries per sync, first included (1-20)
# ASSET_SYNC_QUEUE_BACKOFF_MS=60000      # exponential base delay between retries
# ASSET_SYNC_QUEUE_KEEP_COMPLETED=10     # completed jobs retained
# ASSET_SYNC_QUEUE_KEEP_FAILED=50        # failed jobs retained for inspection
# ASSET_SYNC_QUEUE_PUBLISH_TIMEOUT_MS=2000  # cap on enqueue blocking a request

# CoinGecko
# Optional API key for plans that require one (e.g. the demo plan). Never commit
# a real key; read from the environment only. The base URL is trusted server
# configuration and must be https.
# COINGECKO_API_KEY=your-coingecko-api-key
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINGECKO_TIMEOUT_MS=10000             # per-request timeout (1000-60000)
# COINGECKO_RETRIES=2                    # retries per page for transient failures (0-5)
# COINGECKO_BACKOFF_MS=1000              # exponential base delay between retries

# Public base URL of this deployment. Advertised as a server entry in the
# OpenAPI document. Leave unset for local-only runs.
# PUBLIC_API_URL=https://api.your-domain.com

# Allowed CORS origin for cross-origin browser requests.
# Required in production; defaults to http://localhost:4321 in development.
# Use a single absolute URL — wildcard (*) is not supported with credentials.
# CORS_ORIGIN=https://app.your-domain.com

# Parent domain the authentication cookies are scoped to.
#
# Set this ONLY when the frontend and the API are served from different hosts
# under one registrable domain — the app./api. split the two URLs above
# describe. Without it the cookies are host-only: set by api.your-domain.com,
# they are sent to that host and nowhere else, so the Next.js proxy on
# app.your-domain.com cannot read access_token and the browser cannot read
# csrf_token for the double-submit header. Authentication appears to work at
# login and then fails on the first navigation.
#
# LEAVE UNSET for localhost and Docker. There a single host serves both ports,
# host-only cookies already reach both, and setting this would break them.
#
# ── SECURITY ──────────────────────────────────────────────────────────────
# A Domain cookie is sent to EVERY subdomain of that parent, on every request.
# HttpOnly does not protect it there: any server under the domain reads the
# Cookie header directly, so it sees access_token and refresh_token in full.
#
# Only set this when every host under the parent domain is trusted and
# operated by you. Specifically, it is UNSAFE if any of these are true:
#   - subdomain takeover is possible (a dangling CNAME/A record pointing at a
#     deprovisioned host someone else can claim)
#   - any subdomain is hosted by a third party (status page, docs, marketing,
#     help desk, CI previews) — that vendor receives your session cookies
#   - wildcard DNS (*.your-domain.com) resolves to shared infrastructure
#   - untrusted or user-controlled content is served from any sibling subdomain
#
# If you cannot guarantee all of the above, do not set this: serve the API
# under the app's own origin via an edge proxy instead, and keep cookies
# host-only.
#
# Note: setting a Domain also rules out the `__Host-` cookie prefix, which is
# defined as forbidding the Domain attribute.
#
# Rollout: browsers that already hold the old host-only cookies keep them
# alongside the new domain-scoped ones until they expire on their own
# (15 minutes for access_token, 7 days for refresh_token). Logout clears the
# domain-scoped cookies, since the clearing path reads the same options as the
# writer. No migration step is required.
# COOKIE_DOMAIN=.your-domain.com

# Initial Owner bootstrap (`pnpm seed:owner`)
# Credentials for the single, backend-only command that creates the system
# Owner. Optional at normal startup; required only when running `seed:owner`.
# Never commit real credentials — set these in your environment/secrets store.
# OWNER_EMAIL=admin@example.com
# OWNER_PASSWORD=ChangeMe!1234

# Security
# BCRYPT_ROUNDS=10  # legacy bcrypt cost factor (4-15); verification-only, retained for pre-migration hashes.
# ARGON2_MEMORY_COST=65536   # Argon2id memory in KB (min 8192, default 65536)
# ARGON2_TIME_COST=3         # Argon2id iterations (min 1, default 3)
# ARGON2_PARALLELISM=4       # Argon2id lanes (min 1, default 4)
# ARGON2_HASH_LENGTH=32      # Argon2id output bytes (default 32; salt is the 16-byte Argon2 default)

# Secrets (generate strong values for production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme
CSRF_TOKEN_SECRET=changeme
# Keys the HMAC behind device identifiers and rate-limit Redis keys. Required in
# production (>=32 chars, entropy checked) and must differ from the secrets
# above; defaulted outside production. Rotating it resets every derived device
# id and every rate-limit counter at once.
SECURITY_HASH_SECRET=changeme

# Environment
NODE_ENV=development

# Logging
# LOG_LEVEL=info|debug|warn|error|silent
LOG_LEVEL=debug
# E2E_LOGS=true  # Enable request logs during e2e testing
