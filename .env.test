# Email — Mailpit, the `mailpit` service in docker/compose.yml.
#
# The suite runs on the host, so this is the published SMTP port rather than
# the `mailpit:1025` the backend container uses. Same server either way.
#
# Nothing here is a credential. Mailpit runs with --smtp-auth-accept-any and
# takes whatever arrives, so these exist only because env.schema.ts requires
# them and the production transport sends them. Choosing Gmail or Mailpit is
# this block and nothing else: there is one SMTP implementation and it does not
# know which server answered.
#
# Most specs never reach SMTP at all — createTestApp swaps the email service
# for a capturing fake. The specs under test/email/ opt into the real pipeline
# and read the delivered message back out of Mailpit; start it with
# `docker compose -f docker/compose.yml up -d mailpit` before running them.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=dashboard-e2e@mailpit.test
EMAIL_APP_PASSWORD=mailpit-accepts-any-password
EMAIL_FROM=Dashboard E2E <no-reply@mailpit.test>
# Rendered into every subject and body, and asserted on by the Mailpit specs.
APP_NAME=Dashboard E2E
# Mailpit's HTTP API and web UI. Read by test/helpers/mailpit.helper.ts only;
# the application knows nothing about it.
MAILPIT_API_URL=http://localhost:8025
BCRYPT_ROUNDS=4
# Lower costs speed up the test suite; behaviour under production parameters is
# covered by the password-hashing e2e spec and the benchmark.
ARGON2_MEMORY_COST=8192
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1
LOG_LEVEL=error
# Owner bootstrap credentials for the `seed:owner` command under test.
OWNER_EMAIL=owner@test.com
OWNER_PASSWORD=Owner@12345
# Keep a retry from stalling a spec. Each Jest worker already owns a Redis
# database index, so workers never share an email queue.
EMAIL_QUEUE_BACKOFF_MS=100
EMAIL_QUEUE_KEEP_COMPLETED=0
EMAIL_QUEUE_KEEP_FAILED=0
# REDIS_PASSWORD=undefined
# REDIS_DB=0
CORS_ORIGIN=http://localhost:4321
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mintegs_test_logs
