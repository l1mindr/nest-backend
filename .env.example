# Database
DATA_SOURCE_USERNAME=postgres
DATA_SOURCE_PASSWORD=changeme
DATA_SOURCE_HOST=localhost
DATA_SOURCE_PORT=5432
DATA_SOURCE_DATABASE=mintegs_db
# DATA_SOURCE_POOL_SIZE=10
# DATA_SOURCE_CONNECT_TIMEOUT_MS=10000
# DATA_SOURCE_IDLE_TIMEOUT_MS=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Sessions
MAX_ACTIVE_SESSIONS=10

# Email (Gmail SMTP)
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM="You <you@gmail.com>"
# APP_NAME=NestJS Backend

# Public base URL of this deployment. Advertised as a server entry in the
# OpenAPI document. Leave unset for local-only runs.
# PUBLIC_API_URL=https://api.your-domain.com

# Security
# BCRYPT_ROUNDS=10  # bcrypt cost factor (4-15). Lower values speed up tests.

# Secrets (generate strong values for production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme
CSRF_TOKEN_SECRET=changeme

# Environment
NODE_ENV=development

# Logging
# LOG_LEVEL=info|debug|warn|error|silent
LOG_LEVEL=debug
# E2E_LOGS=true  # Enable request logs during e2e testing
