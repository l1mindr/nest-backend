# Local configuration for the backend development stack.
#
# Copy to `.env` in this directory to activate:
#   cp nest-backend/compose/.env.example nest-backend/compose/.env
#
# Optional — compose.dev.yml defaults to every value below. Compose reads this
# file automatically for the `${VAR:-default}` substitutions, because it sits
# next to the compose file, and that stays true when the frontend stack
# `include`s it. `.env` is gitignored; never commit real secrets.
#
# The backend service also lists this file under `env_file:`, so anything it
# contains reaches the container even if compose.dev.yml never names it — that
# is how variables like COINGECKO_API_KEY get through. Compose applies
# `environment:` after `env_file:`, so for the variables the stack *does* name,
# the `${VAR}` substitution above is what takes effect. Either way, setting a
# value here works.
#
# Infrastructure hosts (DATA_SOURCE_HOST, REDIS_HOST, MONGODB_URI) are set in
# compose.dev.yml to Docker service names and must NOT be pointed at localhost
# here: inside the backend container, localhost is the backend itself.

# ── Application port (host side) ──────────────────────────────────────────────
#
# Changing this also means updating NEXT_PUBLIC_API_BASE_URL in
# next-dashboard-frontend/compose/.env, which is where the browser learns the
# backend's address.
BACKEND_HOST_PORT=8080

# ── Infrastructure ports (host side) ──────────────────────────────────────────
#
# Offset from the defaults so this stack coexists with locally installed
# Postgres (5432), Redis (6379) and MongoDB (27017). Container-side ports are
# unchanged, so nothing inside the network is affected by these values.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6382
MONGO_HOST_PORT=27019

# Mailpit keeps its own defaults — nothing else is likely to be listening on
# them. 1025 is SMTP (the backend delivers here, and so does the backend's
# email E2E suite running on the host); 8025 is the web UI and REST API.
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_WEB_HOST_PORT=8025

# ── CORS ──────────────────────────────────────────────────────────────────────
#
# Must exactly match the browser origin serving the frontend — that is
# FRONTEND_HOST_PORT in next-dashboard-frontend/compose/.env. A wildcard is not
# supported: authentication uses cookies with credentials enabled.
CORS_ORIGIN=http://localhost:3000

# ── Secrets ───────────────────────────────────────────────────────────────────
#
# compose.dev.yml ships throwaway development values that satisfy the length and
# entropy checks in src/infrastructure/config/env/env.schema.ts. Generate your
# own with the project's script if you prefer:  pnpm generate:secrets
#
# All four must be distinct — the schema rejects duplicates.
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# CSRF_TOKEN_SECRET=
# SECURITY_HASH_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
#
# Left unset, the backend delivers to the `mailpit` service on the Compose
# network and every email is readable at http://localhost:8025. That is the
# intended default for development and test: no credentials, nothing sent to a
# real recipient, and a mailbox you can open. Which provider is in use is
# decided entirely by the variables below — the backend has one SMTP
# implementation and does not know which server answered.
#
# Uncomment these to send through Gmail instead. Doing so means real messages
# to real addresses: a mistyped recipient in a test is then someone's inbox.
# For Gmail, create an App Password (a normal account password is refused with
# EAUTH).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=you@gmail.com
# EMAIL_APP_PASSWORD=your-16-char-app-password
# EMAIL_FROM="You <you@gmail.com>"
# APP_NAME=c-folio

# ── Owner bootstrap (the `owner-bootstrap` service and `pnpm seed:owner`) ─────
#
# The account the frontend's Playwright integration and topology lanes sign in
# as. Seeded on every `up`, idempotently.
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=ChangeMe!1234

# ── Cookie topology ───────────────────────────────────────────────────────────
#
# Unset keeps the auth cookies host-only, which is correct when the browser
# reaches both services on `localhost`. The frontend's topology lane wants
# `.localtest.me` here — see next-dashboard-frontend/playwright.topology.config.ts.
# COOKIE_DOMAIN=

# ── Optional ──────────────────────────────────────────────────────────────────
#
# LOG_LEVEL=debug
# COINGECKO_API_KEY=            # asset sync runs unauthenticated without it
# MAX_ACTIVE_SESSIONS=10
