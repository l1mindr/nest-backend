# Database
DATA_SOURCE_USERNAME=postgres
DATA_SOURCE_PASSWORD=changeme
DATA_SOURCE_HOST=localhost
DATA_SOURCE_PORT=5432
DATA_SOURCE_DATABASE=mintegs_db
# DATA_SOURCE_POOL_SIZE=10
# DATA_SOURCE_CONNECT_TIMEOUT_MS=10000
# DATA_SOURCE_IDLE_TIMEOUT_MS=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Sessions
MAX_ACTIVE_SESSIONS=10

# Email (Gmail SMTP)
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM="You <you@gmail.com>"
# APP_NAME=NestJS Backend

# Email queue (BullMQ, on the Redis instance above)
# Email delivery is asynchronous and at-least-once; see docs/email.md.
# QUEUE_PREFIX=bull                      # namespace, if several deployments share one Redis
# EMAIL_QUEUE_ATTEMPTS=5                 # total tries per email, first included (1-20)
# EMAIL_QUEUE_BACKOFF_MS=5000            # exponential base delay between tries
# EMAIL_QUEUE_KEEP_COMPLETED=100         # completed jobs retained
# EMAIL_QUEUE_KEEP_FAILED=1000           # failed jobs retained for inspection
# EMAIL_QUEUE_PUBLISH_TIMEOUT_MS=2000    # cap on publishing blocking a request

# Public base URL of this deployment. Advertised as a server entry in the
# OpenAPI document. Leave unset for local-only runs.
# PUBLIC_API_URL=https://api.your-domain.com

# Security
# BCRYPT_ROUNDS=10  # legacy bcrypt cost factor (4-15); verification-only, retained for pre-migration hashes.
# ARGON2_MEMORY_COST=65536   # Argon2id memory in KB (min 8192, default 65536)
# ARGON2_TIME_COST=3         # Argon2id iterations (min 1, default 3)
# ARGON2_PARALLELISM=4       # Argon2id lanes (min 1, default 4)
# ARGON2_HASH_LENGTH=32      # Argon2id output bytes (default 32; salt is the 16-byte Argon2 default)

# Secrets (generate strong values for production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme
CSRF_TOKEN_SECRET=changeme
# Keys the HMAC behind device identifiers and rate-limit Redis keys. Required in
# production (>=32 chars, entropy checked) and must differ from the secrets
# above; defaulted outside production. Rotating it resets every derived device
# id and every rate-limit counter at once.
SECURITY_HASH_SECRET=changeme

# Environment
NODE_ENV=development

# Logging
# LOG_LEVEL=info|debug|warn|error|silent
LOG_LEVEL=debug
# E2E_LOGS=true  # Enable request logs during e2e testing
